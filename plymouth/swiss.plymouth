[Plymouth Theme]
Name=Swiss
Description=Swiss type block, pulsing squircle passphrase, hairline progress.
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/swiss
ScriptFile=/usr/share/plymouth/themes/swiss/swiss.script
ConsoleLogBackgroundColor=0x101315
MonospaceFont=Cantarell 11
Font=Cantarell 11
